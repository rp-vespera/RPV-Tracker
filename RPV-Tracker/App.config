<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Base URL of the RPV Workforce API. Same value the web client reads from
             NEXT_PUBLIC_API_URL in .env.local.
             TEMPORARY: pointed at the local backend (D:\tracker\tracker, `php artisan serve`)
             for testing the new session-summary audit endpoints. Revert to
             https://api.rp-vespera.cloud/api before shipping a build. -->
        <add key="Rpv.ApiBaseUrl" value="https://api.rp-vespera.cloud/api" />

        <!-- true  = run on local sample data, sign in with demo / demo, never call the API.
             false = sign in against Rpv.ApiBaseUrl for real (RPV Workforce Laravel backend). -->
        <add key="Rpv.DemoMode" value="false" />

        <add key="Rpv.RequestTimeoutSeconds" value="20" />

        <!-- Time tracker: screenshot cadence and where captures are stored.
             IntervalSeconds, when > 0, overrides IntervalMinutes (use it to test without
             waiting a full interval). ScreenshotRoot defaults to
             %LOCALAPPDATA%\RPV Workforce\Screenshots when left blank. -->
        <add key="Rpv.Tracking.IntervalMinutes" value="20" />
        <add key="Rpv.Tracking.IntervalSeconds" value="0" />
        <add key="Rpv.Tracking.ScreenshotRoot" value="" />

        <!-- Pulse / Habit service: serves this person's tasks (shared/me) and performance
             (me/performance). Separate service from the RPV login backend; authenticates with
             the per-user X-Habit-Token below. The token is a PERSONAL SECRET — treat it like a
             password and replace it per user (copy from the web app's localStorage 'habitToken'). -->
        <add key="Rpv.Habit.ApiBaseUrl" value="https://37-59-111-221.sslip.io/api" />
        <add key="Rpv.Habit.Token" value="7965344d5f441f06" />

        <!-- Tracker uploads: each interval's screenshot + activity metrics is posted to
             POST /v1/tracker-sessions on Rpv.ApiBaseUrl above (Sanctum-authenticated, stores
             images in Cloudflare R2 server-side). UploadEnabled=false keeps screenshots local only. -->
        <add key="Rpv.Tracker.UploadEnabled" value="true" />
    </appSettings>
</configuration>
